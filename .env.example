# Copy to .env.local and fill in real values. Vite only exposes vars
# prefixed with VITE_ to client code; none of these are secret (they're
# public IDs meant to be embedded in the built JS bundle).

# Contact form: sign up at https://formspree.io, create a form, and use
# its endpoint ID (the part after /f/ in the form's endpoint URL).
# Without this, the contact form shows a "not configured" message and
# directs visitors to email directly instead.
VITE_FORMSPREE_ENDPOINT_ID=

# Analytics (optional): a Plausible domain (plausible.io) enables a
# lightweight, cookie-free pageview snippet. Leave unset to disable.
VITE_PLAUSIBLE_DOMAIN=

# Error tracking (optional): a Sentry DSN (sentry.io) enables client-side
# error reporting. Leave unset to disable.
VITE_SENTRY_DSN=
